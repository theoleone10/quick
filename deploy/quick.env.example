# Copy to deploy/secrets/quick.env and fill in. Never commit the real file.

# Your domain (DNS on Cloudflare). Sites live at https://<name>.example.com
QUICK_DOMAIN=example.com
QUICK_PUBLIC_URL=https://example.com

# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web application)
# Authorized redirect URI: https://example.com/_quick/auth/callback
QUICK_GOOGLE_CLIENT_ID=
QUICK_GOOGLE_CLIENT_SECRET=

# Who may sign in (comma-separated). At least one is required.
QUICK_ALLOWED_EMAILS=
QUICK_ALLOWED_DOMAINS=

# Optional: enables quick.ai on every site
ANTHROPIC_API_KEY=

# Long random string: signs logins and authorises CLI deploys.
# python -c "import secrets; print(secrets.token_urlsafe(32))"
QUICK_SECRET=
